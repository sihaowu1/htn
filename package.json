    "openai": "7.19.0",
    "pg": "^8.23.0",
    "playwright": "1.63.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.4",
    "@types/pg": "^8.23.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
