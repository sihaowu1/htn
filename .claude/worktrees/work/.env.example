# OpenAI credentials and model used for orchestration and workers.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Browserbase credentials used to create isolated browser sessions.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# Optional Sentry DSN for error and performance reporting.
SENTRY_DSN=

# HTTP server port.
PORT=3000

# Discovery limits.
CRAWL_MAX_STATES=100
CRAWL_MAX_DEPTH=8
CRAWL_TIMEOUT_MS=600000

# Worker execution limits.
WORKER_MAX_ACTIONS=30
WORKER_TIMEOUT_MS=300000
MAX_WORKERS=5
