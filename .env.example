# OpenAI credentials and model used for orchestration and workers.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Cheap, low-reasoning model used only for goal-directed HTTP crawling.
OPENAI_CRAWLER_MODEL=gpt-5.6-luna
# Cheap, low-reasoning model used only to select diverse worker paths.
OPENAI_ORCHESTRATOR_MODEL=gpt-5.6-luna

# Browserbase credentials used to create isolated browser sessions.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# Optional Sentry DSN for error and performance reporting.
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Authoritative evidence database and content-addressed artifact storage.
# Local PostgreSQL:
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/agent_observer
# Supabase session pooler (portable TLS; replace every placeholder):
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PERCENT_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require&uselibpqcompat=true
# For certificate and hostname verification, use sslmode=verify-full and configure
# each machine with Supabase's downloaded CA certificate instead.
ARTIFACT_DIR=artifacts

# Durable investigation worker limits.
INVESTIGATION_CONCURRENCY=2
INVESTIGATION_MAX_ATTEMPTS=3
INVESTIGATION_LEASE_MS=300000
INVESTIGATION_MAX_TOOL_CALLS=30
INVESTIGATION_MAX_EVENTS=200
INVESTIGATION_MAX_ARTIFACT_BYTES=262144

# HTTP server port.
PORT=3000

# Discovery limits.
CRAWL_MAX_STATES=100
CRAWL_MAX_DEPTH=8
CRAWL_TIMEOUT_MS=600000

# Worker execution limits.
WORKER_MAX_ACTIONS=30
WORKER_TIMEOUT_MS=300000
WORKER_LINGER_MS=30000
MAX_WORKERS=5
MAX_PATHS=3
